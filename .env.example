# --- Server ---
PORT=3000
# Interface to bind. Loopback by default, so the server is not on your LAN unless you
# say so. Use `tailscale serve` to reach it from a phone rather than opening this up.
HOST=127.0.0.1
# Where the SQLite database lives. On Railway point this at the persistent volume,
# e.g. /data/traveler.db
DATABASE_PATH=./data/traveler.db

# --- Trafiklab (optional) ---
# Only needed for live vehicle positions (GTFS-Realtime).
# Get one at https://www.trafiklab.se/ -> "GTFS Regional" -> Realtime.
# Bronze (30k calls/month) is too small for a live map; ask for Silver.
# Without this key every other feature still works.
TRAFIKLAB_GTFS_RT_KEY=

# How often to poll vehicle positions while at least one client is watching (ms).
VEHICLE_POLL_INTERVAL_MS=4000

# Enables POST /api/catalog/sync (Bearer auth). Leave unset and the route does not
# exist -- which is the right default for a public deployment.
ADMIN_TOKEN=

# --- Catalog sync ---
# How often to re-pull SL's stop/line catalog and diff it into SQLite (ms).
CATALOG_SYNC_INTERVAL_MS=86400000
# Sync once on boot if the catalog is empty, has never synced successfully, or is
# older than CATALOG_SYNC_INTERVAL_MS. Runs in the background; reads are never blocked.
CATALOG_SYNC_ON_BOOT=true

# --- Web (build time) ---
# MapLibre style. Defaults to a keyless OSM raster style served by the API.
# For production, drop a .pmtiles basemap on the Railway volume and set
# VITE_MAP_STYLE=/api/map/style.json
VITE_MAP_STYLE=
VITE_API_BASE=
