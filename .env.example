# --- Server ---
PORT=3000
# Interface to bind. Loopback by default, so the server is not on your LAN unless you
# say so. Use `tailscale serve` to reach it from a phone rather than opening this up.
HOST=127.0.0.1
# Where the SQLite database lives. On Railway point this at the persistent volume,
# e.g. /data/traveler.db
DATABASE_PATH=./data/traveler.db

# --- Auth ---
# Signing key for sessions, invite links and API keys. Required when
# NODE_ENV=production; without it, development uses a fixed string that is in the
# source and says so at boot. Generate one with `openssl rand -base64 32`.
# Rotating it signs everyone out, which is the emergency lever.
AUTH_SECRET=

# The origin this instance is reached on, e.g. https://traveler.up.railway.app or
# https://homelab.example.ts.net:8443. Defaults to http://localhost:$PORT in
# development; required when NODE_ENV=production.
# It decides whether session cookies are marked secure, it is the base of every invite
# link, and it is where Google sends people back to. For `bun run dev` (Vite on :5173
# proxying /api) set it to http://localhost:5173, the origin that serves the pages.
AUTH_BASE_URL=

# Google sign-in. An OAuth client (Web application) from
# https://console.cloud.google.com with "<AUTH_BASE_URL>/api/auth/callback/google" as
# an authorised redirect URI. Both or neither; without them only invite links sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Extra origins allowed to call the auth API, comma separated. In the split-port dev
# setup the browser is on Vite's origin, so name it here:
# AUTH_TRUSTED_ORIGINS=http://localhost:5173
AUTH_TRUSTED_ORIGINS=

# --- Trafiklab (optional) ---
# Only needed for live vehicle positions (GTFS-Realtime).
# Get one at https://www.trafiklab.se/ -> "GTFS Regional" -> Realtime.
# Bronze (30k calls/month) is too small for a live map; ask for Silver.
# Without this key every other feature still works.
TRAFIKLAB_GTFS_RT_KEY=
# Static GTFS (routes and trips) is a separate Trafiklab product; a key without it
# answers 403. Names every live vehicle by line and mode, and lets the commute map pick
# the vehicle of your departure. Falls back to the realtime key when unset.
TRAFIKLAB_GTFS_STATIC_KEY=

# How often to poll vehicle positions while at least one client is watching (ms).
VEHICLE_POLL_INTERVAL_MS=4000

# Enables POST /api/catalog/sync (Bearer auth). Leave unset and the route does not
# exist -- which is the right default for a public deployment.
ADMIN_TOKEN=

# --- Walking routes ---
# Pedestrian routing for walking neighbourhoods around saved places. The public
# FOSSGIS server is free under a fair-use policy (1 request/s, which the client
# enforces). Point at your own Valhalla if that ever stops being enough.
VALHALLA_URL=https://valhalla1.openstreetmap.de

# --- Catalog sync ---
# How often to re-pull SL's stop/line catalog and diff it into SQLite (ms).
CATALOG_SYNC_INTERVAL_MS=86400000
# Sync once on boot if the catalog is empty, has never synced successfully, or is
# older than CATALOG_SYNC_INTERVAL_MS. Runs in the background; reads are never blocked.
CATALOG_SYNC_ON_BOOT=true

# --- Maps ---
# No map key is needed. Unset, /api/map/style.json serves OpenFreeMap (keyless, no
# quota) in a dark and a light flavour. Point this at a Protomaps archive on the volume
# to self-host the basemap instead, e.g. /data/stockholm.pmtiles
PMTILES_PATH=

# --- Web (build time) ---
# Overrides the whole MapLibre style URL. Unset, the app asks the API for
# /api/map/style.json?theme=dark|light, which is what you want unless you are pointing
# at a basemap this server does not serve.
VITE_MAP_STYLE=
VITE_API_BASE=
